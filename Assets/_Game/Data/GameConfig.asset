  segments:
  - name: "C\u1ED5ng l\xE0ng - C\u1ED5ng hanok"
    unlockCost: 0
    stageSegment: 0
    dialogue: []
  - name: "Ph\u1ED1 \u0111\xE8n l\u1ED3ng"
    unlockCost: 8000
    stageSegment: 0
    dialogue:
    - speaker: mayor
      text: "Ph\u1ED1 \u0111\xE8n l\u1ED3ng \u0111\xE3 s\xE1ng! T\u1EEB gi\u1EDD
        s\u1EBD c\xF3 c\u1EA3 \u0111o\xE0n du l\u1ECBch, food blogger v\xE0 kh\xE1ch
        s\u1ED9p gh\xE9 th\u0103m."
    - speaker: minji
      text: "Ch\xE0o anh ch\u1ECB, em l\xE0 Min-ji, du h\u1ECDc sinh H\xE0n Qu\u1ED1c.
        Em s\u1EBD gi\u1EDBi thi\u1EC7u c\xE1c m\xF3n H\xE0n \u1EDF \u0111\xE2y nh\xE9!"
  - name: "Ph\u1ED1 c\xE0 ph\xEA v\xE0 tr\xE1ng mi\u1EC7ng"
    unlockCost: 1200000
    stageSegment: 0
    dialogue:
    - speaker: mayor
      text: "Ph\u1ED1 c\xE0 ph\xEA v\xE0 tr\xE1ng mi\u1EC7ng m\u1EDF c\u1EEDa r\u1ED3i.
        \u0102n no th\xEC ph\u1EA3i c\xF3 c\xE0 ph\xEA, \u0111\xE1 b\xE0o ch\u1EE9!"
  - name: "Ph\u1ED1 \u0111\u1ED3 n\u01B0\u1EDBng"
    unlockCost: 20000000
    stageSegment: 0
    dialogue:
    - speaker: minji
      text: "Ph\u1ED1 \u0111\u1ED3 n\u01B0\u1EDBng! Th\u1ECBt n\u01B0\u1EDBng H\xE0n,
        b\xE1nh x\xE8o Vi\u1EC7t, b\xE1nh h\xE0nh ng\xE0y m\u01B0a, th\u01A1m l\u1EEBng
        c\u1EA3 ph\u1ED1."
  - name: "Qu\u1EA3ng tr\u01B0\u1EDDng s\xE2n kh\u1EA5u"
    unlockCost: 6000000000
    stageSegment: 1
    dialogue:
    - speaker: mayor
      text: "Ph\u1ED1 \u0111\xE3 \u0111\u1EE7 5 \u0111o\u1EA1n! Ch\xFAng ta t\u1ED5
        ch\u1EE9c l\u1EC5 khai tr\u01B0\u01A1ng to\xE0n ph\u1ED1 n\xE0o!"
    - speaker: ongba
      text: "Ch\xE0o ch\xE1u, ta l\xE0 \xD4ng Ba. Qu\u1EA3ng tr\u01B0\u1EDDng n\xE0y
        c\u1EA7n nh\u1EEFng ti\u1EBFt m\u1EE5c bi\u1EC3u di\u1EC5n."
    - speaker: ongba
      text: "H\xE3y m\u1EDDi ngh\u1EC7 s\u0129 r\u1ED3i b\u1EA5m v\xE0o s\xE2n kh\u1EA5u
        \u0111\u1EC3 bi\u1EC3u di\u1EC5n, kh\xE1ch s\u1EBD k\xE9o \u0111\u1EBFn \u0111\xF4ng
        g\u1EA5p \u0111\xF4i!"
